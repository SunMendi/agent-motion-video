  "segments": [
    {
      "start": 0.0,
      "end": 4.12,
      "text": " पाज्जन दर्शनिक अक तेभी ले बोशे आचन, शामने गरूं गरूं खाबर,"
    },
    {
      "start": 4.58,
      "end": 6.68,
      "text": " किन्तू क्यो खेते पाच्चन ना, क्यानू?"
    },
    {
      "start": 7.34,
      "end": 11.12,
      "text": " इता शुदू गल्पूना, इता कमपूटरे सब चे भरो समच्चा,"
    },
    {
      "start": 11.6,
      "end": 12.8,
      "text": " गल्पूटा ईरोकुम."
    },
    {
      "start": 12.8,
      "end": 18.28,
      "text": " 5. Namedilam P1-P5. Gold Tablet 4-500 boshayachen."
    },
    {
      "start": 18.62,
      "end": 23.12,
      "text": " Proteke shamne ek plate khabar. Ar dujuner majkhane ek takone kathi."
    },
    {
      "start": 23.52,
      "end": 27.1,
      "text": " Mot kathi 5-ta. Khethe hole lagbe 2-ta kathi."
    },
    {
      "start": 27.46,
      "end": 30.94,
      "text": " Ekta danhate ekta bamhate. Ekta kathi die to khawajabena."
    },
    {
      "start": 31.46,
      "end": 35.78,
      "text": " Ebar dekhun ki holo. 5-jun ek sathe bamhate er kathi-ta tulenilen."
    },
    {
      "start": 36.2,
      "end": 39.06,
      "text": " Ekon shobai danhate er kathi-tjunno apekhakochen."
    },
    {
      "start": 39.06,
      "end": 41.78,
      "text": " किंदू दान हते रुग ने आप पाशल जोने रहते"
    },
    {
      "start": 41.78,
      "end": 44.64,
      "text": " किंदू काछि छर भेनना, क्यो खेते वैजना"
    },
    {
      "start": 44.64,
      "end": 46.48,
      "text": " पूरो सिस्टम आडके गलो"
    },
    {
      "start": 46.48,
      "end": 47.9,
      "text": " उता आई धेड़लोक"
    },
    {
      "start": 47.9,
      "end": 52.04,
      "text": " सब अपक्या इगो थखा करचे ऎज एगो च्छे न अग्ट्तर शमोण शाचे"
    },
    {
      "start": 52.04,
      "end": 77.76,
      "text": " Dharun, P2 ar P3 barbar khachen, kibdu P1 barbar kathipachen na, tinishudhu boshe achen khudharto, sujoghipachen na, echa ke bole starvation, tayi computer re ahta niyom lage, concurrency control, manne pasha pashi dujon aaki kathi akshathhe babohar kote parben na, aksjon khele, aksjon apekha korbe, tahole shomadhan ta ki, sheta porer porbe, semaphore."
    },
    {
      "start": 78.2,
      "end": 80.88,
      "text": " Part 2, chayle komente likhun, Part 2"
    }
  ],
