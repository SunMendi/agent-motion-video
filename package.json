{
  "name": "agent-motion-video",
  "version": "1.0.0",
  "description": "Open-source workspace for coding agents to generate motion graphics videos with Remotion",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SunMendi/agent-motion-video.git"
  },
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/effects": "^4.0.536",
    "@remotion/google-fonts": "^4.0.536",
    "@remotion/media": "^4.0.536",
    "@remotion/player": "^4.0.536",
    "@remotion/transitions": "^4.0.536",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "framer-motion": "^14.3.0",
    "lucide-react": "^1.59.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.536",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "^19.3.0",
    "@types/web": "0.0.166",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "10.12.0",
    "fontkit": "^2.0.4",
    "pngjs": "^7.0.0",
    "prettier": "3.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "dev:app": "vite",
    "build:app": "vite build",
    "preview:app": "vite preview",
    "build:css": "tailwindcss -i src/index.css -o src/compiled.css",
    "dev": "remotion studio",
    "studio": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "align": "tsx scripts/align.ts",
    "music": "tsx scripts/music.ts",
    "render": "remotion render",
    "render:rust": "tsx scripts/render-rust.ts",
    "check:rust": "tsx scripts/check-rust.ts",
    "ad": "tsx scripts/render.ts",
    "check": "tsx scripts/check.ts",
    "snapshots": "tsx scripts/snapshot.ts",
    "snapshots:update": "tsx scripts/snapshot.ts --update",
    "new-ad": "tsx scripts/new-ad.ts",
    "video:doctor": "node scripts/video-workspace.mjs doctor",
    "video:check": "node scripts/video-workspace.mjs check",
    "video:prepare": "node scripts/video-workspace.mjs prepare",
    "video:compile": "node scripts/video-workspace.mjs compile",
    "video:check-production": "node scripts/video-workspace.mjs check-production",
    "video:check-motion": "node scripts/video-motion-check.mjs",
    "video:css": "node scripts/video-workspace.mjs css",
    "video:studio": "node scripts/video-workspace.mjs studio",
    "video:render": "node scripts/video-workspace.mjs render",
    "video:verify": "node scripts/video-workspace.mjs verify",
    "video:check-9x16": "node scripts/video-workspace.mjs check-9x16",
    "video:export": "node scripts/video-workspace.mjs export",
    "video:reset": "node scripts/video-workspace.mjs reset",
    "video:smoke": "node scripts/video-workspace.mjs smoke",
    "video:test": "node --test tests/workspace.test.mjs tests/video-production.test.mjs && vitest run tests/video-timeline.test.ts --maxWorkers=1"
  },
  "allowScripts": {
    "esbuild": false
  }
}
